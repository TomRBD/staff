{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "fastify"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}