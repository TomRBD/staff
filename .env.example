# URL publique du site (sans slash final). En https, les cookies passent en Secure.
# Sur Vercel : facultatif, l'URL de prod du projet est utilisée par défaut.
PUBLIC_URL=http://localhost:5173
PORT=3000

# Base de données (libSQL)
# Local / Docker : fichier SQLite. Vercel : URL Turso libsql://... + jeton
# (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, posées par l'intégration Vercel, sont aussi acceptées)
DATABASE_URL=file:./data/planner.db
DATABASE_AUTH_TOKEN=

# Secret de signature des sessions : openssl rand -hex 32
JWT_SECRET=

# Application Discord (https://discord.com/developers/applications > OAuth2)
# Redirect URI à déclarer : ${PUBLIC_URL}/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs Discord des admins, séparés par des virgules (accès garanti, rôle admin)
ADMIN_DISCORD_IDS=

# Optionnel : inscription automatique des membres d'un serveur Discord
# (si DISCORD_ROLE_ID est renseigné, seul ce rôle est accepté)
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=

# Optionnel : notifications des événements dans un salon Discord
DISCORD_WEBHOOK_URL=

# Plage horaire affichée (heure de début incluse, heure de fin exclue)
DAY_START=8
DAY_END=23

# Dev uniquement (ignoré sur Vercel) : connexion sans Discord via /api/auth/dev?pseudo=Tom
DEV_LOGIN=0
